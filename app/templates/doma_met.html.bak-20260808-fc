{% extends 'base.html' %}

{% block content %}
<div id="map-container" style="width: 100%; height: 100vh; position: relative; z-index: 1;">
    {{ mapa_html | safe }}
    <div id="legend-doma-met" class="sapo-legend-container">
        <button class="sapo-legend-toggle" type="button" title="Mostrar capas">
            <span style="display:inline-flex;align-items:center;gap:6px;">
                <span class="sapo-legend-dot"></span>
                <span>Leyenda</span>
            </span>
            <svg class="arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="4,10 8,6 12,10"/>
            </svg>
        </button>
        <div class="sapo-legend-body"></div>
    </div>
    <div class="legend">
        <img src="https://gis-eco.ifop.cl/geoserver/Ifop_Sapo/wms?REQUEST=GetLegendGraphic&amp;VERSION=1.1.0&amp;FORMAT=image/png&amp;WIDTH=120&amp;HEIGHT=50&amp;LAYER=Ifop_Sapo:Precip_GFS_v1&amp;STYLE=Precip_heatmap&amp;legend_options=fontSize:25" alt="Escala Precipitación" style="width: auto; height: 300px;">
    </div>
</div>

<div style="position: fixed; bottom: 8px; left: 8px; z-index: 1000; font-size: 10px; color: #6c757d; background: rgba(255,255,255,0.7); padding: 2px 6px; border-radius: 4px;">
    DOMA Met · Viento: {{ wind_date }} · Oleaje: {{ wave_date }} · Precip: {{ precip_date }}
</div>
{% endblock %}
